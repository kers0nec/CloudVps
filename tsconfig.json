{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "schemas.js",
    "errors.js",
    "database.js",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "vps_instances",
    "data",
    "test",
    "server.js",
    "*.test.ts",
    "*.spec.ts"
  ]
}